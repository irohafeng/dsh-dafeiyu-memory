{
  "name": "dsh-dafeiyu-memory",
  "version": "0.5.8",
  "description": "大肥鱼的记忆：情节 + 心得 + 技能。记忆库和记忆系统是分开的，库可以放在任何地方、可以移动。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "dafeiyu"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
